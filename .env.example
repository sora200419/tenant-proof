# Copy to .env.preview (or .env.preprod). Never commit the real file.

# The 24-word recovery phrase of a test wallet funded with tNIGHT from the faucet.
# Single spaces between words, no quotes, on one line.
MIDNIGHT_PREVIEW_ALICE_MNEMONIC=

# Encrypts the private state and signing key kept in .mnkit/private-state/.
# At least 16 characters, mixing upper case, lower case, digits and symbols.
MIDNIGHT_PRIVATE_STATE_PASSWORD=

# Preprod only: a Blockfrost project id.
BLOCKFROST_PROJECT_ID=
