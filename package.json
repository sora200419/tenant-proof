{
  "name": "tenant-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/tenant-proof.compact contract/managed/tenant-proof",
    "compile:fast": "compact compile --skip-zk contract/tenant-proof.compact contract/managed/tenant-proof",
    "typecheck": "tsc --noEmit -p .",
    "test:sim": "vitest run --passWithNoTests .sim.test.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run --exclude 'src/**/*.sim.test.ts'",
    "test:local": "MIDNIGHT_NETWORK=local npm test --",
    "test:preview": "MIDNIGHT_NETWORK=preview npm test --",
    "test:preprod": "MIDNIGHT_NETWORK=preprod npm test --",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server",
    "wait:dust": "vite-node scripts/wait-for-dust.ts",
    "deploy": "vite-node scripts/deploy.ts",
    "deploy:preview": "MIDNIGHT_NETWORK=preview npm run deploy --",
    "deploy:preprod": "MIDNIGHT_NETWORK=preprod npm run deploy --",
    "dev": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.5",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/testkit-js": "5.0.0",
    "@midnightntwrk/dapp-connector-api": "4.1.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vite": "6.4.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnightntwrk/zkir-v3": "3.2.0"
  }
}
